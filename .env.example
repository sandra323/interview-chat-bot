# Backend — copy to .env.local at repo root (gitignored). Never commit real keys.
PORT=3001
NODE_ENV=development

# Required: server-side DeepSeek credentials (never expose to the frontend)
DEEPSEEK_API_KEY=
DEEPSEEK_API_URL=https://api.deepseek.com/chat/completions
DEEPSEEK_DEFAULT_MODEL=deepseek-v4-flash

# Required: demo login (no plaintext AUTH_PASSWORD — hash only)
AUTH_USERNAME=demo
# Generate hash after `npm install` (do not commit real values):
#   node -e "require('bcryptjs').hash('your-password', 10).then(console.log)"
# If require fails, run from repo root after install, or:
#   npm exec -w @ai-chat/backend -- node -e "require('bcryptjs').hash('your-password', 10).then(console.log)"
AUTH_PASSWORD_HASH=
# Absolute session TTL in hours (default 24)
AUTH_SESSION_TTL_HOURS=24

# Production: comma-separated allowed browser origins for CORS
# CORS_ORIGIN=https://your-frontend.example.com
